{
  "name": "@petesmithofficial/showcase-hero",
  "version": "0.2.0",
  "description": "A customizable React showcase hero with an interactive item workbench.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "private": false,
  "license": "MIT",
  "keywords": [
    "react",
    "hero",
    "showcase",
    "portfolio",
    "component"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petesmithofficial/showcase-hero.git"
  },
  "bugs": {
    "url": "https://github.com/petesmithofficial/showcase-hero/issues"
  },
  "homepage": "https://github.com/petesmithofficial/showcase-hero#readme",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "src/styles.css",
    "*.css"
  ],
  "files": [
    "CHANGELOG.md",
    "dist",
    "docs",
    "src/components",
    "src/hooks",
    "src/ShowcaseHero.tsx",
    "src/index.ts",
    "src/styles.css",
    "src/styles.css.d.ts",
    "src/types.ts",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./src/styles.css.d.ts",
      "default": "./src/styles.css"
    }
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8788",
    "build": "vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview --host 0.0.0.0 --port 8788",
    "prepublishOnly": "npm run verify",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run build && node scripts/verify.mjs"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
